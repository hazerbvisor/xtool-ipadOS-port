{
  "schemaVersion": 1,
  "name": "XToolMobileApp",
  "bundleIdentifier": "sh.xtool.mobile",
  "deploymentTarget": "16.0",
  "executableTarget": "XToolMobileApp",
  "targets": [
    {
      "name": "XToolMobileCore",
      "sources": [
        "Sources/XToolMobileCore"
      ],
      "parseAsLibrary": true
    },
    {
      "name": "XToolMobileApp",
      "sources": [
        "Sources/XToolMobileApp"
      ],
      "dependencies": [
        "XToolMobileCore"
      ],
      "parseAsLibrary": false
    }
  ],
  "frameworks": [
    "CryptoKit",
    "Foundation",
    "Security",
    "SwiftUI",
    "UIKit"
  ],
  "infoPlist": "XToolMobileInfo.plist",
  "shortVersion": "1.0.2",
  "buildVersion": "3",
  "reuseCompilerEngine": true,
  "reuseBundledRuntime": true
}
